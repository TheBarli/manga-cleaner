/*/////////////////////////////////*/
/*   ADOBE ILLUSTRATOR DARK QSS    */
/*/////////////////////////////////*/

QMainWindow, QWidget {
    background-color: #262626;
    color: #f5f5f5;
    font-family: "Segoe UI Variable", "Segoe UI", -apple-system, sans-serif;
}

/* Menu Bar */
QMenuBar {
    background-color: #323232;
    color: #b8b8b8;
    border-bottom: 1px solid #222222;
    padding: 2px 4px;
    font-size: 11px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #4a4a4a;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #ff9a00;
    color: #141414;
}

#NavBar {
    background-color: #323232;
    border-bottom: 1px solid #222222;
}

#SidePanel {
    background-color: #323232;
    border: 1px solid #222222;
    border-radius: 6px;
    padding: 8px;
}

#TitleLabel {
    color: #ff9a00;
    font-weight: bold;
    font-size: 16px;
}

/* Tool & Action Buttons */
QPushButton {
    background-color: #3d3d3d;
    border: 1px solid #222222;
    border-radius: 4px;
    padding: 7px 12px;
    color: #b8b8b8;
    font-weight: 600;
    font-size: 11px;
}

QPushButton:hover {
    background-color: #4a4a4a;
    border: 1px solid #555555;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #2c2c2c;
}

QPushButton:checked {
    background-color: #ff9a00;
    color: #141414;
    border: 1px solid #ff9a00;
    font-weight: bold;
}

#PrimaryBtn {
    background-color: #ff9a00;
    color: #141414;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
}

#PrimaryBtn:hover {
    background-color: #ffad33;
    color: #141414;
}

#PrimaryBtn:pressed {
    background-color: #e68a00;
}

#ActionBtn {
    background-color: #3d3d3d;
    border: 1px solid #ff9a00;
    color: #ffad33;
    border-radius: 4px;
}

#ActionBtn:hover {
    background-color: #4a4a4a;
    border: 1px solid #ffad33;
    color: #ffffff;
}

#ActionBtn:pressed {
    background-color: #2c2c2c;
}

/* Sliders */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #222222;
    margin: 2px 0;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #ff9a00;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #ff9a00;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffad33;
    border: 2px solid #ffffff;
}

/* List Widget */
QListWidget {
    background-color: #262626;
    border: 1px solid #222222;
    border-radius: 4px;
    outline: none;
    padding: 4px;
}

QListWidget::item {
    padding: 7px 10px;
    border-bottom: 1px solid #2c2c2c;
    border-radius: 3px;
    color: #b8b8b8;
}

QListWidget::item:hover {
    background-color: #383838;
    color: #ffffff;
}

QListWidget::item:selected {
    background-color: #3f3525;
    color: #ffad33;
    border-left: 3px solid #ff9a00;
}

/* Progress Bar */
QProgressBar {
    background-color: #3d3d3d;
    border: 1px solid #222222;
    border-radius: 4px;
    text-align: center;
    color: #b8b8b8;
    font-size: 10px;
}

QProgressBar::chunk {
    background-color: #ff9a00;
    border-radius: 3px;
}

/* Splitter */
QSplitter::handle {
    background-color: #323232;
}

QSplitter::handle:hover {
    background-color: #ff9a00;
}

/* Menu & Popup */
QMenu {
    background-color: #323232;
    border: 1px solid #222222;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 18px 6px 14px;
    border-radius: 3px;
    color: #f5f5f5;
    font-size: 11px;
}

QMenu::item:selected {
    background-color: #4a4a4a;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #222222;
    margin: 4px 6px;
}

/* Scrollbars */
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 8px;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #3d3d3d;
    min-height: 20px;
    min-width: 20px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #4a4a4a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
}

/* Checkbox */
QCheckBox, QListView {
    outline: none;
}

QCheckBox::indicator, QListView::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #4a4a4a;
    border-radius: 3px;
    background-color: #262626;
}

QCheckBox::indicator:hover, QListView::indicator:hover {
    border: 1px solid #ff9a00;
}

QCheckBox::indicator:checked, QListView::indicator:checked {
    background-color: #ff9a00;
    border: 1px solid #ff9a00;
}

/* Status Bar */
QStatusBar {
    background-color: #323232;
    color: #b8b8b8;
    border-top: 1px solid #222222;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}
